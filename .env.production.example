# Groupify production env — Dokploy "Environment variables" (compose/dokploy UI)
# REQUIRED (random values — generate with `openssl rand -base64 24` and
# `openssl rand -hex 16`):
APP_KEY=
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Build args (Dokploy build section, NOT env) — the browser's WS endpoint:
#   VITE_REVERB_HOST=groupify.dxtechph.online
#   VITE_REVERB_PORT=443
#   VITE_REVERB_SCHEME=https
#   VITE_REVERB_APP_KEY=<same value as REVERB_APP_KEY>

APP_ENV=production
APP_URL=https://groupify.dxtechph.online
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/data/database.sqlite
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
BROADCAST_CONNECTION=reverb
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
DB_BUSY_TIMEOUT=30000
DB_JOURNAL_MODE=wal
