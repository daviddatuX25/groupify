# syntax=docker/dockerfile:1
# Groupify production image (AD-10 single box: nginx + php-fpm + queue + Reverb + scheduler)
FROM node:22 AS assets
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
# Vite env is baked at build time — the WS endpoint the browser uses
ARG VITE_REVERB_HOST=localhost
ARG VITE_REVERB_PORT=8080
ARG VITE_REVERB_SCHEME=http
ARG VITE_REVERB_APP_KEY=groupify-app-key
ENV VITE_REVERB_HOST=$VITE_REVERB_HOST VITE_REVERB_PORT=$VITE_REVERB_PORT VITE_REVERB_SCHEME=$VITE_REVERB_SCHEME VITE_REVERB_APP_KEY=$VITE_REVERB_APP_KEY
RUN npm run build

FROM composer:2 AS vendor
WORKDIR /build
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --prefer-dist --no-scripts --optimize-autoloader

FROM php:8.4-fpm
RUN apt-get update && apt-get install -y --no-install-recommends \
    nginx supervisor libsqlite3-dev libicu-dev libzip-dev zip \
    && docker-php-ext-install pdo_sqlite intl zip \
    && docker-php-ext-configure pcntl --enable-pcntl \
    && docker-php-ext-install pcntl \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /var/www/html
COPY --from=vendor /build/vendor ./vendor
COPY . .
COPY --from=assets /build/public/build ./public/build

RUN mkdir -p storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && touch database/database.sqlite \
    && chown -R www-data:www-data storage bootstrap/cache database

COPY docker/prod/nginx.conf /etc/nginx/sites-enabled/default
COPY docker/prod/supervisord-groupify.conf /etc/supervisor/conf.d/groupify.conf
COPY docker/prod/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 80 8080
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

# Docker-level liveness (Dokploy shows container health from this)
HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
    CMD curl -fsS http://127.0.0.1/health || exit 1
